{
  "name": "@mgpl-diagnostics/invoice-kit",
  "version": "2.0.0",
  "description": "MGPL Diagnostics patient invoices — BACKEND kit (Node.js): pricing, paise-exact totals, React/PDF rendering on the report-kit letterhead, and the combined reports + invoices HTTP API (Next.js, Fastify, Express…). Frontends use @mgpl-diagnostics/client.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "github:mgpl-diagnostics/invoice-kit",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-test.tsx",
    "examples": "tsx scripts/generate-examples.tsx",
    "prepare": "tsup",
    "test:api": "tsx scripts/api-test.ts",
    "llms": "node scripts/llms-full.mjs @mgpl-diagnostics/invoice-kit README.md AGENTS.md llms.txt docs package.json src scripts"
  },
  "peerDependencies": {
    "@mgpl-diagnostics/report-kit": "^2.0.0",
    "react": ">=18",
    "react-dom": ">=18",
    "fastify": ">=4"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "bwip-js": "^4.11.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fontkit": "^2.0.4",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "fastify": "^5.12.5",
    "@mgpl-diagnostics/client": "^1.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  }
}
