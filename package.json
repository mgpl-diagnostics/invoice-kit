{
  "name": "@mgpl-diagnostics/invoice-kit",
  "version": "1.0.0",
  "description": "MGPL Diagnostics patient invoices: React (HTML) + pure Node.js A4 PDF on the Navy Sidebar letterhead.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "github:mgpl-diagnostics/invoice-kit",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-test.tsx",
    "examples": "tsx scripts/generate-examples.tsx"
  },
  "peerDependencies": {
    "@mgpl-diagnostics/report-kit": "^1.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "bwip-js": "^4.11.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fontkit": "^2.0.4",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
